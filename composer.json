{
    "name": "ksfraser/ksf-fa-square",
    "description": "FrontAccounting to Square POS Connector - Push products, sync inventory, collect payments via Square Terminal, and import sales orders",
    "type": "frontaccounting-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Kevin Fraser",
            "email": "kevin@ksfraser.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ksfraser/Traits.git"
        }
    ],
    "require": {
        "php": ">=7.4",
        "square/square": "^40.0.0",
        "ksfraser/exceptions": "^1.3",
        "ksfraser/traits": "dev-main",
        "ksfraser/genericinterface": "^0.6",
        "ksfraser/file": "dev-main",
        "ksfraser/ksf-modules-dao": "^0.3",
        "ksfraser/contact-dto": "^0.1",
        "ksfraser/ksf-fa-common": "*",
        "ksfraser/import-staging": "*",
        "ksfraser/staging-dto": "^0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "ksfraser/famock": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\Square\\": "src/"
        },
        "files": [
            "src/Models/WebhookEventType.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\Square\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
